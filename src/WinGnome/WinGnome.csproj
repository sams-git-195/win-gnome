<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Rendered from Theme/Logo.xaml by tools/Export-AppIcon.ps1. -->
    <ApplicationIcon>Assets\wingnome.ico</ApplicationIcon>
    <RootNamespace>WinGnome</RootNamespace>
    <AssemblyName>WinGnome</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinGnome.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinGnome.Core\WinGnome.Core.csproj" />
  </ItemGroup>

</Project>
