<Window x:Class="WinGnome.Features.Dock.DockWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinGnome.Features.Dock"
        Title="WinGnome Dock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        FontFamily="{StaticResource ShellFont}">
    <Window.Resources>
        <!-- Replaced from code: the accent colour or the user's indicator colour. -->
        <SolidColorBrush x:Key="DockIndicatorBrush" Color="#3584E4" />

        <!-- Pinned or running app. -->
        <DataTemplate DataType="{x:Type local:DockAppEntry}">
            <Grid x:Name="Slot"
                  Width="{Binding Appearance.CellSize}"
                  Height="{Binding Appearance.CellSize}"
                  Background="#01000000"
                  ToolTip="{Binding Name}"
                  ToolTipService.Placement="{Binding Appearance.ToolTipPlacement}"
                  ToolTipService.HorizontalOffset="{Binding Appearance.ToolTipHorizontalOffset}"
                  ToolTipService.VerticalOffset="{Binding Appearance.ToolTipVerticalOffset}"
                  ToolTipService.InitialShowDelay="350">
                <Border x:Name="FocusHighlight" Visibility="Collapsed"
                        CornerRadius="{Binding Appearance.HighlightRadius}"
                        Background="{DynamicResource HoverBrush}" />
                <Border x:Name="HoverHighlight" Opacity="0"
                        CornerRadius="{Binding Appearance.HighlightRadius}"
                        Background="{DynamicResource HoverBrush}" />
                <Grid x:Name="BounceHost">
                    <Image x:Name="IconImage" Source="{Binding Icon}"
                           Width="{Binding Appearance.IconSize}" Height="{Binding Appearance.IconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border x:Name="FallbackTile" Visibility="Collapsed"
                            Width="{Binding Appearance.IconSize}" Height="{Binding Appearance.IconSize}"
                            CornerRadius="{Binding Appearance.IconTileRadius}"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="{Binding Initial}" FontSize="{Binding Appearance.FallbackFontSize}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Indicators}" IsHitTestVisible="False" Focusable="False"
                              Visibility="{Binding Appearance.IndicatorVisibility}"
                              HorizontalAlignment="{Binding Appearance.IndicatorHorizontalAlignment}"
                              VerticalAlignment="{Binding Appearance.IndicatorVerticalAlignment}"
                              Margin="{Binding Appearance.IndicatorMargin}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding Appearance.IndicatorOrientation}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="4" Height="4" Margin="1.5" Fill="{DynamicResource DockIndicatorBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                    <Setter TargetName="FocusHighlight" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FallbackTile" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="Slot" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverHighlight" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverHighlight" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Line between pinned and running apps. -->
        <DataTemplate DataType="{x:Type local:DockSeparatorEntry}">
            <Grid Width="{Binding Appearance.SeparatorSlotWidth}" Height="{Binding Appearance.SeparatorSlotHeight}"
                  Background="#01000000">
                <Rectangle Width="{Binding Appearance.SeparatorLineWidth}" Height="{Binding Appearance.SeparatorLineHeight}"
                           Fill="{DynamicResource ForegroundBrush}" Opacity="0.3"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Show Applications and Recycle Bin. -->
        <DataTemplate DataType="{x:Type local:DockActionEntry}">
            <Grid x:Name="Slot"
                  Width="{Binding Appearance.CellSize}"
                  Height="{Binding Appearance.CellSize}"
                  Background="#01000000"
                  ToolTip="{Binding Name}"
                  ToolTipService.Placement="{Binding Appearance.ToolTipPlacement}"
                  ToolTipService.HorizontalOffset="{Binding Appearance.ToolTipHorizontalOffset}"
                  ToolTipService.VerticalOffset="{Binding Appearance.ToolTipVerticalOffset}"
                  ToolTipService.InitialShowDelay="350">
                <Border x:Name="HoverHighlight" Opacity="0"
                        CornerRadius="{Binding Appearance.HighlightRadius}"
                        Background="{DynamicResource HoverBrush}" />
                <Grid x:Name="BounceHost">
                    <Image x:Name="IconImage" Source="{Binding Icon}"
                           Width="{Binding Appearance.IconSize}" Height="{Binding Appearance.IconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="FallbackGlyph" Visibility="Collapsed" Text="&#xE74D;"
                               FontFamily="{StaticResource IconFont}" FontSize="{Binding Appearance.GlyphSize}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- GNOME's 3x3 "Show Applications" dots. -->
                    <Viewbox x:Name="AppsGlyph" Visibility="Collapsed"
                             Width="{Binding Appearance.GlyphSize}" Height="{Binding Appearance.GlyphSize}">
                        <Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="6" Height="6" Fill="{DynamicResource ForegroundBrush}" />
                            <Ellipse Canvas.Left="9" Canvas.Top="1" Width="6" Height="6" Fill="{DynamicResource ForegroundBrush}" />
                            <Ellipse Canvas.Left="17" Canvas.Top="1" Width="6" Height="6" Fill="{DynamicResource ForegroundBrush}" />
                            <Ellipse Canvas.Left="1" Canvas.Top="9" Width="6" Height="6" Fill="{DynamicResource ForegroundBrush}" />
                            <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" Fill="{DynamicResource ForegroundBrush}" />
                            <Ellipse Canvas.Left="17" Canvas.Top="9" Width="6" Height="6" Fill="{DynamicResource ForegroundBrush}" />
                            <Ellipse Canvas.Left="1" Canvas.Top="17" Width="6" Height="6" Fill="{DynamicResource ForegroundBrush}" />
                            <Ellipse Canvas.Left="9" Canvas.Top="17" Width="6" Height="6" Fill="{DynamicResource ForegroundBrush}" />
                            <Ellipse Canvas.Left="17" Canvas.Top="17" Width="6" Height="6" Fill="{DynamicResource ForegroundBrush}" />
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Declared last so it wins over the fallback above. -->
                <DataTrigger Binding="{Binding IsShowApplications}" Value="True">
                    <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AppsGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="Slot" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverHighlight" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverHighlight" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!--
        The window is larger than the dock: it also covers the gap to the screen edge and transparent headroom for
        magnified icons. Fully transparent pixels of a layered window let clicks through, so only the dock itself
        (and the near-invisible #01 strip down to the screen edge) is hit-testable.
    -->
    <Grid x:Name="SlideHost" Background="#01000000" AllowDrop="True">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid x:Name="Body">
            <Border x:Name="BodyBackground" />
            <Border x:Name="BodyOutline" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <ItemsControl x:Name="Items" Focusable="False" ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:DockItemsPanel Loaded="OnItemsPanelLoaded" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
