<UserControl x:Class="WinGnome.Features.Settings.Views.GeneralPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls">
    <StackPanel>
        <c:SettingsGroup Header="Startup">
            <c:SettingsRow Title="Start with Windows" Subtitle="{Binding StartWithWindowsSubtitle}">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding StartWithWindows.Value}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Taskbar">
            <c:SettingsRow Title="Which taskbar do you want?" Subtitle="The Windows taskbar is always restored when WinGnome exits."
                           IsStacked="True">
                <ListBox Style="{DynamicResource ChoiceCardListBox}" ItemsSource="{Binding TaskbarMode.Options}"
                         SelectedItem="{Binding TaskbarMode.Selected}" AutomationProperties.Name="Taskbar mode">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{DynamicResource RowTitleText}" />
                                <TextBlock Text="{Binding Description}" Style="{DynamicResource RowSubtitleText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </c:SettingsRow>
            <c:SettingsRow Title="Auto-hide the taskbar" Subtitle="Restored when WinGnome exits."
                           Visibility="{Binding IsNativeTaskbar, Converter={x:Static c:Converters.BoolToVisibility}}">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding NativeTaskbarAutoHide.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Style the native taskbar" Subtitle="Hide the search box, Task View or Copilot buttons, or centre the icons."
                           Visibility="{Binding IsNativeTaskbar, Converter={x:Static c:Converters.BoolToVisibility}}">
                <Button Content="Style the native taskbar&#x2026;" Style="{DynamicResource SettingsButton}"
                        Command="{Binding StyleTaskbarCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Appearance">
            <c:SettingsRow Title="Theme" Subtitle="Colours of the top bar menus, dock, overview and this window.">
                <ListBox Style="{DynamicResource SegmentedListBox}" ItemsSource="{Binding Theme.Options}"
                         SelectedItem="{Binding Theme.Selected}" DisplayMemberPath="Label" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Windows">
            <c:SettingsRow Title="Center new windows" Subtitle="Newly opened windows appear in the middle of the screen, as in GNOME.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding CenterNewWindows.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Focus follows mouse" Subtitle="The window under the pointer gets focus. Applies for this session only and is restored on exit.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding FocusFollowsMouse.Value}" />
            </c:SettingsRow>
        </c:SettingsGroup>
    </StackPanel>
</UserControl>
