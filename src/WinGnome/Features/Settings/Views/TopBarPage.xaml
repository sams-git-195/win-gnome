<UserControl x:Class="WinGnome.Features.Settings.Views.TopBarPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             xmlns:tb="clr-namespace:WinGnome.Features.TopBar.Controls">
    <StackPanel>
        <!-- Live preview: the checkerboard makes translucency visible. Blur cannot be previewed. -->
        <Border CornerRadius="12" Margin="0,0,0,24" Padding="16" MinHeight="120" ClipToBounds="True"
                Background="{DynamicResource PreviewBackdropBrush}">
            <Border DataContext="{Binding Preview}" VerticalAlignment="Top" Height="{Binding Height}"
                    Margin="{Binding Margin}" tb:PillCorners.Radius="{Binding CornerRadius}" Background="{Binding Background}"
                    TextElement.Foreground="{Binding Foreground}" TextElement.FontSize="{Binding FontSize}"
                    TextElement.FontFamily="{Binding FontFamily}" TextElement.FontWeight="Bold"
                    AutomationProperties.Name="Top bar preview">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <tb:WindowsLogo Size="13" Fill="{Binding Foreground}" Margin="0,0,16,0" VerticalAlignment="Center"
                                        Visibility="{Binding ShowLogo, Converter={x:Static c:Converters.BoolToVisibility}}" />
                        <!-- Shown hovered, so the hover corner radius is visible. -->
                        <Border Background="{Binding ItemHover}" tb:PillCorners.Radius="{Binding ItemCornerRadius}" Padding="8,3" Margin="-8,0,4,0"
                                Visibility="{Binding ShowActivities, Converter={x:Static c:Converters.BoolToVisibility}}">
                            <TextBlock Text="Activities" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowWorkspaces, Converter={x:Static c:Converters.BoolToVisibility}}">
                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding Foreground}" />
                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding Foreground}" Opacity="0.4" />
                            <Ellipse Width="8" Height="8" Fill="{Binding Foreground}" Opacity="0.4" />
                        </StackPanel>
                        <TextBlock Text="Files"
                                   Visibility="{Binding ShowAppName, Converter={x:Static c:Converters.BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ClockText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <tb:SymbolicIcon Icon="NetworkWireless" Size="{Binding IconSize}" Margin="0,0,10,0" />
                        <tb:SymbolicIcon Icon="AudioVolumeHigh" Size="{Binding IconSize}" Margin="0,0,10,0" />
                        <tb:SymbolicIcon Icon="BatteryLevel90" Size="{Binding IconSize}" />
                        <TextBlock Text="87%" Margin="4,0,0,0"
                                   Visibility="{Binding ShowBatteryText, Converter={x:Static c:Converters.BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <c:SettingsGroup>
            <c:SettingsRow Title="Show top bar" Subtitle="A GNOME-style bar across the top of the screen.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding Enabled.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Show on" Subtitle="Every display gets its own full bar; menus open on the display you clicked.">
                <ListBox Style="{DynamicResource SegmentedListBox}" ItemsSource="{Binding Monitors.Options}"
                         SelectedItem="{Binding Monitors.Selected}" DisplayMemberPath="Label" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Appearance">
            <c:SettingsRow Title="Background colour" Subtitle="Light presets also switch the text to a dark colour.">
                <c:ColorPickerRow DataContext="{Binding Background}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Text colour">
                <c:ColorPickerRow DataContext="{Binding Foreground}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Opacity" Content="{Binding Opacity}" />
            <c:SettingsRow Title="Blur effect" Subtitle="Visible when opacity is below 100%.">
                <ComboBox ItemsSource="{Binding Blur.Options}" SelectedItem="{Binding Blur.Selected}" DisplayMemberPath="Label" />
            </c:SettingsRow>
            <c:SettingsRow Title="Height" Content="{Binding Height}" />
            <c:SettingsRow Title="Font" Subtitle="Adwaita Sans is GNOME's own typeface, bundled with WinGnome.">
                <ComboBox ItemsSource="{Binding Font.Options}" SelectedItem="{Binding Font.Selected}" DisplayMemberPath="Label" />
            </c:SettingsRow>
            <c:SettingsRow Title="Text size" Content="{Binding FontSize}" />
            <c:SettingsRow Title="Floating margin" Subtitle="0 = classic edge-to-edge bar." Content="{Binding Margin}" />
            <c:SettingsRow Title="Corner radius" Content="{Binding CornerRadius}" />
            <c:SettingsRow Title="Hover corner radius" Subtitle="Highlight behind bar items and tray icons: 0 = square, 100 = pill." Content="{Binding ItemCornerRadius}" />
        </c:SettingsGroup>

        <c:SettingsGroup Header="Contents">
            <c:SettingsRow Title="Logo menu" Subtitle="A Windows logo at the far left with settings, Task Manager and power options, like the macOS Apple menu.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowLogoMenu.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Activities button">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowActivities.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Workspace indicator" Subtitle="Dots for your virtual desktops.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowWorkspaces.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Focused app name">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowAppName.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Battery percentage">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowBattery.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Tray icons" Subtitle="Notification-area icons next to the system indicators, like macOS menu bar extras.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowTrayIcons.Value}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Clock">
            <c:SettingsRow Title="Time format">
                <ListBox Style="{DynamicResource SegmentedListBox}" ItemsSource="{Binding ClockStyle.Options}"
                         SelectedItem="{Binding ClockStyle.Selected}" DisplayMemberPath="Label" />
            </c:SettingsRow>
            <c:SettingsRow Title="Show date">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowDate.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Show weekday">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowWeekday.Value}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Show seconds">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding ShowSeconds.Value}" />
            </c:SettingsRow>
        </c:SettingsGroup>
    </StackPanel>
</UserControl>
