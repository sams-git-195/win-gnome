<UserControl x:Class="WinGnome.Features.Settings.Views.AboutPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls">
    <StackPanel>
        <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,24" Padding="24">
            <StackPanel>
                <TextBlock Text="WinGnome" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Style="{DynamicResource RowSubtitleText}" Margin="0,2,0,12" />
                <TextBlock Style="{DynamicResource RowTitleText}"
                           Text="A lightweight shell companion that makes Windows 11 feel like GNOME, with a dash of macOS: a top bar, a dock, round window buttons, an Activities overview and reversible streamline tweaks. WinGnome puts everything back the way it was when it exits." />
            </StackPanel>
        </Border>

        <c:SettingsGroup Header="Files" Description="{Binding Error}">
            <c:SettingsRow Title="Settings folder" Subtitle="{Binding SettingsFolder}">
                <Button Content="Open folder" Style="{DynamicResource SettingsButton}" Command="{Binding OpenFolderCommand}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Log file" Subtitle="{Binding LogFile}">
                <Button Content="Open log" Style="{DynamicResource SettingsButton}" Command="{Binding OpenLogCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Reset">
            <c:SettingsRow Title="Reset all settings" Subtitle="Returns every WinGnome setting to its default. Registry tweaks are not touched.">
                <Button Content="Reset&#x2026;" Style="{DynamicResource SettingsDestructiveButton}" Command="{Binding ResetCommand}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Quit WinGnome" Subtitle="Closes the top bar, dock and overview and restores the Windows taskbar.">
                <Button Content="Quit" Style="{DynamicResource SettingsButton}" Command="{Binding QuitCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>
    </StackPanel>
</UserControl>
