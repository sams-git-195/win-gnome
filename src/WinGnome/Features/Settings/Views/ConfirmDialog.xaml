<Window x:Class="WinGnome.Features.Settings.Views.ConfirmDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{StaticResource ShellFont}" FontSize="15">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WinGnome;component/Theme/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Style="{StaticResource GroupHeaderText}" FontSize="18" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" Style="{StaticResource RowSubtitleText}" FontSize="14" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SettingsButton}" IsCancel="True" />
            <Button x:Name="ConfirmButton" Style="{StaticResource SettingsAccentButton}" Margin="8,0,0,0" Click="OnConfirmClick" />
            <Button x:Name="DangerButton" Style="{StaticResource SettingsDangerButton}" Margin="8,0,0,0" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
