<Window x:Class="WinGnome.Features.Settings.Views.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
        Title="WinGnome Settings" Width="940" Height="680" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{StaticResource ShellFont}" FontSize="15">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="12,16,12,12">
            <TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource GroupHeaderText}" FontSize="18" Margin="12,0,0,14" />
            <ListBox Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource SidebarItem}"
                     ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                     AutomationProperties.Name="Settings pages">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="30"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <ScrollViewer x:Name="PageScroller" Grid.Column="2" Style="{StaticResource SettingsScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="760" Margin="32,28,32,32">
                <StackPanel>
                    <Border Margin="0,0,0,20" Padding="16,12" CornerRadius="12" Background="#33E01B24" BorderBrush="#99E01B24" BorderThickness="1"
                            Visibility="{Binding StorageProblem, Converter={x:Static c:Converters.NotNullToVisibility}}"
                            AutomationProperties.Name="Settings can't be saved">
                        <StackPanel>
                            <TextBlock Text="Changes won't be kept" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding StorageProblem}" TextWrapping="Wrap" Style="{DynamicResource RowSubtitleText}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SelectedPage.Title}" Style="{StaticResource PageTitleText}" Margin="0,0,0,20" />
                    <ContentControl x:Name="PageHost" Content="{Binding SelectedPage}" IsTabStop="False" Focusable="False" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
