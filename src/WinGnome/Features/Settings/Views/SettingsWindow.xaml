<Window x:Class="WinGnome.Features.Settings.Views.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
        Title="Settings" Width="980" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{StaticResource ShellFont}" FontSize="15">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Sidebar groups are separated by a hairline, as in GNOME Settings; the first group has none. -->
            <Style x:Key="SidebarGroup" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <StackPanel>
                                <Border x:Name="Separator" Height="1" Margin="8,6" Background="{DynamicResource BorderBrush}" />
                                <ItemsPresenter />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Row 0 is the header bar (HeaderBarWindow.CaptionHeight): drag area, titles and the round window buttons. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="SidebarTitle" Grid.Row="0" Grid.Column="0" Text="Settings" Style="{StaticResource GroupHeaderText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedEntry.Title}" Style="{StaticResource GroupHeaderText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="160,0" />

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search entry with a placeholder. -->
            <Grid Margin="12,2,12,8">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6"
                         AutomationProperties.Name="Search settings" PreviewKeyDown="OnSearchKeyDown" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="12,0,0,0" IsHitTestVisible="False"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBlock Text="Search" Margin="35,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ListBox x:Name="SidebarList" Grid.Row="1" Margin="12,0,12,12" Style="{StaticResource PlainListBox}"
                     ItemContainerStyle="{StaticResource SidebarItem}"
                     ItemsSource="{Binding Sidebar}" SelectedItem="{Binding SelectedEntry, Mode=OneWay}" IsSynchronizedWithCurrentItem="False"
                     SelectionChanged="OnSidebarSelectionChanged" PreviewMouseLeftButtonUp="OnSidebarMouseUp" PreviewKeyDown="OnSidebarKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="False"
                     AutomationProperties.Name="Settings panels">
                <ListBox.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource SidebarGroup}" AlternationCount="100" />
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LinkArrow" Grid.Column="2" Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" ToolTip="Opens in Windows Settings" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                <Setter TargetName="LinkArrow" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <ScrollViewer x:Name="PageScroller" Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="760" Margin="32,12,32,32">
                <StackPanel>
                    <Border Margin="0,0,0,20" Padding="16,12" CornerRadius="12" Background="#33E01B24" BorderBrush="#99E01B24" BorderThickness="1"
                            Visibility="{Binding StorageProblem, Converter={x:Static c:Converters.NotNullToVisibility}}"
                            AutomationProperties.Name="Settings can't be saved">
                        <StackPanel>
                            <TextBlock Text="Changes won't be kept" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding StorageProblem}" TextWrapping="Wrap" Style="{DynamicResource RowSubtitleText}" />
                        </StackPanel>
                    </Border>
                    <ContentControl x:Name="PageHost" Content="{Binding SelectedPage}" IsTabStop="False" Focusable="False" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
