<UserControl x:Class="WinGnome.Features.Settings.Panels.Power.PowerPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             xmlns:p="clr-namespace:WinGnome.Features.Settings.Panels">
    <StackPanel>
        <p:PanelNotices />

        <c:SettingsGroup Header="Battery" Visibility="{Binding HasBattery, Converter={x:Static c:Converters.BoolToVisibility}}">
            <c:SettingsRow Title="{Binding BatteryState}" Subtitle="{Binding BatteryLevel}">
                <ProgressBar Width="220" Height="8" Minimum="0" Maximum="100" Value="{Binding BatteryPercent, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource PressedBrush}" BorderThickness="0"
                             AutomationProperties.Name="Battery level" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Power Mode" IsEnabled="{Binding CanEdit}"
                         Visibility="{Binding HasPowerMode, Converter={x:Static c:Converters.BoolToVisibility}}">
            <ListBox Margin="16,16,16,8" Style="{DynamicResource ChoiceCardListBox}" ItemsSource="{Binding PowerModes}" SelectedItem="{Binding PowerMode}"
                     AutomationProperties.Name="Power mode">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{DynamicResource RowTitleText}" />
                                <TextBlock Text="{Binding Description}" Style="{DynamicResource RowSubtitleText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Screen Blank" Description="Turn the screen off after this long without activity." IsEnabled="{Binding CanEdit}">
            <ItemsControl ItemsSource="{Binding ScreenBlank}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:SettingsRow Title="{Binding Title}">
                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" />
                        </c:SettingsRow>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Automatic Suspend" Description="Put the computer to sleep after this long without activity." IsEnabled="{Binding CanEdit}">
            <ItemsControl ItemsSource="{Binding Suspend}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:SettingsRow Title="{Binding Title}">
                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" />
                        </c:SettingsRow>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </c:SettingsGroup>

        <p:PanelFooter />
    </StackPanel>
</UserControl>
