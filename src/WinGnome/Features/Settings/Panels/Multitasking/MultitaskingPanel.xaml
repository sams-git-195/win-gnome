<UserControl x:Class="WinGnome.Features.Settings.Panels.Multitasking.MultitaskingPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             xmlns:p="clr-namespace:WinGnome.Features.Settings.Panels">
    <StackPanel>
        <p:PanelNotices />

        <c:SettingsGroup Header="General">
            <c:SettingsRow Title="Hot Corner" Subtitle="Touch the top-left corner of each display to open the Activities overview.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding HotCorner.Value}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Workspaces" Description="Windows adds workspaces (virtual desktops) when you ask: Ctrl+Win+D adds one, Ctrl+Win+F4 closes the current one.">
            <c:SettingsRow Title="Workspace Indicator" Subtitle="Show workspace dots in the top bar.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding WorkspaceIndicator.Value}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Window Snapping" IsEnabled="{Binding CanEdit}"
                         Description="Snap settings are read by Windows when you next snap; some take effect only after you sign in again.">
            <c:SettingsRow Title="Snap Windows" Subtitle="Drag a window to a screen edge to fill half or a quarter of the screen.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding SnapWindows}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Snap Layouts" Subtitle="{Binding SnapLayoutsNote}" IsEnabled="{Binding CanChangeSnapLayouts}">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding SnapLayouts}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Snap Suggestions" Subtitle="After snapping one window, offer others to fill the rest of the screen.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding SnapSuggestions}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="App Switching" IsEnabled="{Binding CanEdit}">
            <c:SettingsRow Title="Alt+Tab includes apps from" IsStacked="True">
                <ListBox Style="{DynamicResource SegmentedListBox}" ItemsSource="{Binding AltTabScopes}" SelectedItem="{Binding AltTabScope}"
                         HorizontalAlignment="Left" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <p:PanelFooter />
    </StackPanel>
</UserControl>
