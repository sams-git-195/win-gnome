<UserControl x:Class="WinGnome.Features.Settings.Panels.Appearance.AppearancePanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             xmlns:p="clr-namespace:WinGnome.Features.Settings.Panels">
    <UserControl.Resources>
        <!-- A style card: a miniature window in the scheme's colours; the chosen one gets an accent ring. -->
        <Style x:Key="StyleCard" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <Border x:Name="Ring" BorderThickness="3" BorderBrush="Transparent" CornerRadius="12" Padding="3">
                                <ContentPresenter />
                            </Border>
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="14" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentItem" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="34" Height="34">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                            <Ellipse Margin="4" Fill="{Binding Brush}" />
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <p:PanelNotices />

        <c:SettingsGroup Header="Style" Description="{Binding StyleNote}">
            <ListBox Margin="16" Style="{DynamicResource PlainListBox}" ItemContainerStyle="{StaticResource StyleCard}"
                     ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" IsEnabled="{Binding CanChangeStyle}"
                     HorizontalAlignment="Center" AutomationProperties.Name="Style">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Width="180" Height="112" CornerRadius="8" Background="#FAFAFA" BorderBrush="#26000000" BorderThickness="1">
                            <Border x:Name="Window" Margin="18,16" CornerRadius="6" Background="#FFFFFF" BorderBrush="#1F000000" BorderThickness="1">
                                <StackPanel Margin="10">
                                    <Border Height="8" Width="60" CornerRadius="4" Background="#3584E4" HorizontalAlignment="Left" />
                                    <Border x:Name="Line1" Height="6" Width="100" CornerRadius="3" Background="#DEDDDA" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                    <Border x:Name="Line2" Height="6" Width="80" CornerRadius="3" Background="#DEDDDA" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="Dark">
                                <Setter TargetName="Card" Property="Background" Value="#242424" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#26FFFFFF" />
                                <Setter TargetName="Window" Property="Background" Value="#303030" />
                                <Setter TargetName="Window" Property="BorderBrush" Value="#1FFFFFFF" />
                                <Setter TargetName="Line1" Property="Background" Value="#505050" />
                                <Setter TargetName="Line2" Property="Background" Value="#505050" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Accent Color" Description="{Binding AccentNote}">
            <ListBox Margin="16,14" Style="{DynamicResource PlainListBox}" ItemContainerStyle="{StaticResource AccentItem}"
                     ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}" IsEnabled="{Binding CanChangeAccent}"
                     HorizontalAlignment="Center" AutomationProperties.Name="Accent colour">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Background">
            <c:SettingsRow Title="Current wallpaper" Subtitle="{Binding WallpaperName}">
                <Border Width="160" Height="90" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource HoverBrush}">
                    <Image Source="{Binding WallpaperPreview}" Stretch="UniformToFill" AutomationProperties.Name="Current wallpaper" />
                </Border>
            </c:SettingsRow>
            <ItemsControl ItemsSource="{Binding Wallpapers}" Margin="12,8,12,12" IsEnabled="{Binding CanEdit}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="4" Padding="0" Style="{DynamicResource FlatButton}" Cursor="Hand"
                                Command="{Binding DataContext.ChooseWallpaperCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Path}" ToolTip="{Binding Path}">
                            <Border Width="160" Height="90" CornerRadius="8" ClipToBounds="True">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:SettingsRow Title="Your own picture" IsEnabled="{Binding CanEdit}">
                <Button Content="Add Picture&#x2026;" Style="{DynamicResource SettingsButton}" Command="{Binding AddPictureCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <p:PanelFooter />
    </StackPanel>
</UserControl>
