<UserControl x:Class="WinGnome.Features.Settings.Panels.Wifi.WifiPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             xmlns:p="clr-namespace:WinGnome.Features.Settings.Panels">
    <StackPanel>
        <p:PanelNotices />

        <c:SettingsGroup Visibility="{Binding HasRadio, Converter={x:Static c:Converters.BoolToVisibility}}">
            <c:SettingsRow Title="Wi-Fi" Subtitle="{Binding WifiSubtitle}">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding WifiOn}" IsEnabled="{Binding CanToggleWifi}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Airplane Mode" Subtitle="Disables Wi-Fi, Bluetooth and mobile broadband. Windows Settings switches it.">
                <Button Content="Open" Style="{DynamicResource SettingsButton}" Command="{Binding AirplaneModeCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <TextBlock Text="No Wi-Fi adapter found." Style="{DynamicResource RowSubtitleText}" Margin="4,0,0,20"
                   Visibility="{Binding ShowsNoAdapter, Converter={x:Static c:Converters.BoolToVisibility}}" />

        <c:SettingsGroup Header="Visible Networks"
                         Visibility="{Binding ShowsLocationNotice, Converter={x:Static c:Converters.BoolToVisibility}}">
            <c:SettingsRow Title="Windows needs location access to show nearby networks"
                           Subtitle="Turn on location access for WinGnome (and for desktop apps) in Windows Settings, then press Refresh. Turning Wi-Fi on or off and disconnecting still work.">
                <Button Content="Open Location Settings" Style="{DynamicResource SettingsButton}" Command="{Binding OpenLocationSettingsCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Visibility="{Binding ShowsConnectedWithoutName, Converter={x:Static c:Converters.BoolToVisibility}}">
            <c:SettingsRow Title="Connected" Subtitle="Windows doesn't share the network's name without location access." />
        </c:SettingsGroup>

        <c:SettingsGroup Header="Visible Networks" ItemsSource="{Binding Networks}"
                         Visibility="{Binding ShowsList, Converter={x:Static c:Converters.BoolToVisibility}}">
            <c:SettingsGroup.ItemTemplate>
                <DataTemplate>
                    <c:SettingsRow Title="{Binding Name}" Subtitle="{Binding Subtitle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,10,0"
                                       VerticalAlignment="Center" Style="{DynamicResource RowSubtitleText}" AutomationProperties.Name="Secured"
                                       Visibility="{Binding IsSecured, Converter={x:Static c:Converters.BoolToVisibility}}" />
                            <TextBlock Text="{Binding SignalGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,10,0"
                                       VerticalAlignment="Center" Style="{DynamicResource RowSubtitleText}" AutomationProperties.Name="Signal strength" />
                            <Button Content="Connect" Style="{DynamicResource SettingsButton}"
                                    Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanConnect, Converter={x:Static c:Converters.BoolToVisibility}}" />
                        </StackPanel>
                        <c:SettingsRow.Details>
                            <WrapPanel>
                                <Button Content="Disconnect" Style="{DynamicResource SettingsButton}" Margin="0,8,8,0"
                                        Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanDisconnect, Converter={x:Static c:Converters.BoolToVisibility}}" />
                                <Button Content="Forget" Style="{DynamicResource SettingsButton}" Margin="0,8,8,0"
                                        Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanForget, Converter={x:Static c:Converters.BoolToVisibility}}" />
                            </WrapPanel>
                        </c:SettingsRow.Details>
                    </c:SettingsRow>
                </DataTemplate>
            </c:SettingsGroup.ItemTemplate>
        </c:SettingsGroup>

        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,20" AutomationProperties.Name="Looking for networks"
                     Visibility="{Binding IsLoading, Converter={x:Static c:Converters.BoolToVisibility}}" />
        <TextBlock Text="No networks found." Style="{DynamicResource RowSubtitleText}" Margin="4,0,0,20"
                   Visibility="{Binding ShowsEmptyListNote, Converter={x:Static c:Converters.BoolToVisibility}}" />

        <c:SettingsGroup>
            <c:SettingsRow Title="Refresh" Subtitle="Looks for networks again.">
                <Button Content="Refresh" Style="{DynamicResource SettingsButton}" Command="{Binding RefreshCommand}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Wi-Fi Hotspot" Subtitle="Windows Settings shares this PC's connection.">
                <Button Content="Open&#x2026;" Style="{DynamicResource SettingsButton}" Command="{Binding HotspotCommand}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Connect to Hidden Network" Subtitle="Windows Settings asks for the name and password.">
                <Button Content="Open&#x2026;" Style="{DynamicResource SettingsButton}" Command="{Binding HiddenNetworkCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <p:PanelFooter />
    </StackPanel>
</UserControl>
