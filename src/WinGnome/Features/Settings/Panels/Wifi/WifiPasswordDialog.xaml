<Window x:Class="WinGnome.Features.Settings.Panels.Wifi.WifiPasswordDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{StaticResource ShellFont}" FontSize="15">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WinGnome;component/Theme/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The settings theme styles TextBox only; the password box gets the same look. -->
            <Style TargetType="PasswordBox">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                              VerticalAlignment="Center" Style="{x:Null}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Authentication Required" Style="{StaticResource GroupHeaderText}" FontSize="18" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" Style="{StaticResource RowSubtitleText}" FontSize="14" Margin="0,10,0,0" />
        <TextBlock x:Name="Note" Style="{StaticResource RowSubtitleText}" FontSize="14" Margin="0,8,0,0"
                   Foreground="{DynamicResource DestructiveBrush}" Visibility="Collapsed" />
        <PasswordBox x:Name="Password" Margin="0,16,0,0" AutomationProperties.Name="Wi-Fi password" />
        <TextBox x:Name="PlainPassword" Margin="0,16,0,0" Visibility="Collapsed" AutomationProperties.Name="Wi-Fi password" />
        <CheckBox x:Name="ShowPassword" Content="Show password" Margin="0,12,0,0" Foreground="{DynamicResource ForegroundBrush}"
                  Checked="OnShowPasswordChanged" Unchecked="OnShowPasswordChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Style="{StaticResource SettingsButton}" IsCancel="True" />
            <Button Content="Connect" Style="{StaticResource SettingsAccentButton}" IsDefault="True" Margin="8,0,0,0" Click="OnConnectClick" />
        </StackPanel>
    </StackPanel>
</Window>
