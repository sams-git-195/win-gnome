<UserControl x:Class="WinGnome.Features.Settings.Panels.PanelFooter" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             Focusable="False" IsTabStop="False">
    <!-- Bottom of every system panel: the way out to the full Windows Settings page. -->
    <c:SettingsGroup>
        <c:SettingsRow Title="More in Windows Settings" Subtitle="Settings this panel doesn't show yet.">
            <Button Style="{DynamicResource SettingsButton}" Command="{Binding OpenInWindowsCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Open" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </c:SettingsRow>
    </c:SettingsGroup>
</UserControl>
