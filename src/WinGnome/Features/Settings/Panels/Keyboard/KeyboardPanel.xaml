<UserControl x:Class="WinGnome.Features.Settings.Panels.Keyboard.KeyboardPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             xmlns:p="clr-namespace:WinGnome.Features.Settings.Panels">
    <StackPanel>
        <p:PanelNotices />

        <c:SettingsGroup Header="Input Sources" Description="Switch between them with Win+Space.">
            <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:SettingsRow Title="{Binding Name}" Subtitle="{Binding Detail}">
                            <TextBlock x:Name="Current" Text="In use" Style="{DynamicResource RowSubtitleText}" Visibility="Collapsed" />
                        </c:SettingsRow>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Current" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:SettingsRow Title="Add or remove input sources">
                <Button Content="Language Settings" Style="{DynamicResource SettingsButton}" Command="{Binding AddSourceCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Key Repeat" IsEnabled="{Binding CanEdit}">
            <c:SettingsRow Title="Delay" Subtitle="How long a key is held before it repeats.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Short" Style="{DynamicResource RowSubtitleText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Minimum="0" Maximum="3" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Delay}" Width="180" />
                    <TextBlock Text="Long" Style="{DynamicResource RowSubtitleText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding DelayText}" Width="70" TextAlignment="Right" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" />
                </StackPanel>
            </c:SettingsRow>
            <c:SettingsRow Title="Speed" Subtitle="How fast a held key repeats.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Slow" Style="{DynamicResource RowSubtitleText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Slider Minimum="0" Maximum="31" SmallChange="1" LargeChange="4" IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Speed}" Width="180" />
                    <TextBlock Text="Fast" Style="{DynamicResource RowSubtitleText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding SpeedText}" Width="110" TextAlignment="Right" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" />
                </StackPanel>
            </c:SettingsRow>
            <c:SettingsRow Title="Test" Subtitle="Hold a key here to try the repeat settings.">
                <TextBox Width="220" AutomationProperties.Name="Key repeat test area" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Typing">
            <c:SettingsRow Title="Typing and touch keyboard" Subtitle="Autocorrect, text suggestions and the touch keyboard.">
                <Button Content="Typing Settings" Style="{DynamicResource SettingsButton}" Command="{Binding ShortcutsCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <p:PanelFooter />
    </StackPanel>
</UserControl>
