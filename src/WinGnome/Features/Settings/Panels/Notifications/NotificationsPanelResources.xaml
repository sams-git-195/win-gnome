<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
                    xmlns:n="clr-namespace:WinGnome.Features.Settings.Panels.Notifications">
    <DataTemplate DataType="{x:Type n:NotificationsPanelViewModel}">
        <n:NotificationsPanel />
    </DataTemplate>

    <!-- The banner and notification-centre switches of an expanded app (the row's Details). -->
    <DataTemplate DataType="{x:Type n:NotificationAppOptions}">
        <StackPanel IsEnabled="{Binding Enabled.IsOn}">
            <Grid Margin="0,0,0,6">
                <TextBlock Text="Show banners" Style="{DynamicResource RowTitleText}" VerticalAlignment="Center" />
                <CheckBox Style="{DynamicResource SettingsToggle}" HorizontalAlignment="Right" IsChecked="{Binding Banner.IsOn}"
                          IsEnabled="{Binding Banner.IsInteractive}" AutomationProperties.Name="Show banners" />
            </Grid>
            <Grid>
                <TextBlock Text="Show in notification centre" Style="{DynamicResource RowTitleText}" VerticalAlignment="Center" />
                <CheckBox Style="{DynamicResource SettingsToggle}" HorizontalAlignment="Right" IsChecked="{Binding Centre.IsOn}"
                          IsEnabled="{Binding Centre.IsInteractive}" AutomationProperties.Name="Show in notification centre" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- One app in the Applications list. -->
    <DataTemplate DataType="{x:Type n:NotificationAppViewModel}">
        <c:SettingsRow Title="{Binding Name}" Details="{Binding Details}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{DynamicResource FlatButton}" Command="{Binding ToggleExpandedCommand}" Margin="0,0,12,0" Padding="8"
                        AutomationProperties.Name="{Binding Name, StringFormat=Options for {0}}">
                    <TextBlock Text="{Binding ExpandGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding Enabled.IsOn}" IsEnabled="{Binding Enabled.IsInteractive}"
                          AutomationProperties.Name="{Binding Name, StringFormat=Notifications from {0}}" />
            </StackPanel>
        </c:SettingsRow>
    </DataTemplate>
</ResourceDictionary>
