<UserControl x:Class="WinGnome.Features.Settings.Panels.About.AboutPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             xmlns:p="clr-namespace:WinGnome.Features.Settings.Panels">
    <StackPanel>
        <p:PanelNotices />

        <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,24" Padding="24,20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="56" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding Info.OperatingSystem, FallbackValue='Reading…'}" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <c:SettingsGroup>
            <c:SettingsRow Title="Device Name">
                <TextBlock Text="{Binding Info.DeviceName}" Style="{DynamicResource RowSubtitleText}" FontSize="14" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Hardware">
            <c:SettingsRow Title="Hardware Model">
                <TextBlock Text="{Binding Info.HardwareModel}" Style="{DynamicResource RowSubtitleText}" FontSize="14" />
            </c:SettingsRow>
            <c:SettingsRow Title="Memory">
                <TextBlock Text="{Binding Info.Memory}" Style="{DynamicResource RowSubtitleText}" FontSize="14" />
            </c:SettingsRow>
            <c:SettingsRow Title="Processor">
                <TextBlock Text="{Binding Info.Processor}" Style="{DynamicResource RowSubtitleText}" FontSize="14" MaxWidth="380" TextAlignment="Right" />
            </c:SettingsRow>
            <c:SettingsRow Title="Graphics">
                <TextBlock Text="{Binding Info.Graphics}" Style="{DynamicResource RowSubtitleText}" FontSize="14" MaxWidth="380" TextAlignment="Right" />
            </c:SettingsRow>
            <c:SettingsRow Title="Disk Capacity">
                <TextBlock Text="{Binding Info.DiskCapacity}" Style="{DynamicResource RowSubtitleText}" FontSize="14" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Software">
            <c:SettingsRow Title="OS Name">
                <TextBlock Text="{Binding Info.OperatingSystem}" Style="{DynamicResource RowSubtitleText}" FontSize="14" MaxWidth="380" TextAlignment="Right" />
            </c:SettingsRow>
            <c:SettingsRow Title="OS Type">
                <TextBlock Text="{Binding Info.OsType}" Style="{DynamicResource RowSubtitleText}" FontSize="14" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <p:PanelFooter />
    </StackPanel>
</UserControl>
