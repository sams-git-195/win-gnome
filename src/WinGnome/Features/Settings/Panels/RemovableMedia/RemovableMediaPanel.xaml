<UserControl x:Class="WinGnome.Features.Settings.Panels.RemovableMedia.RemovableMediaPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             xmlns:p="clr-namespace:WinGnome.Features.Settings.Panels">
    <StackPanel>
        <p:PanelNotices />

        <c:SettingsGroup IsEnabled="{Binding CanChange}">
            <c:SettingsRow Title="Never Prompt or Start Programs on Media Insertion"
                           Subtitle="Turns AutoPlay off for every drive and device.">
                <CheckBox Style="{DynamicResource SettingsToggle}" IsChecked="{Binding AutoplayOff}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Media Types" Description="What Windows does when each kind of media or device appears."
                         ItemsSource="{Binding Rows}" IsEnabled="{Binding CanChooseHandlers}">
            <c:SettingsGroup.ItemTemplate>
                <DataTemplate>
                    <c:SettingsRow Title="{Binding Label}">
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                                  MinWidth="220" MaxWidth="360" />
                    </c:SettingsRow>
                </DataTemplate>
            </c:SettingsGroup.ItemTemplate>
        </c:SettingsGroup>

        <p:PanelFooter />
    </StackPanel>
</UserControl>
