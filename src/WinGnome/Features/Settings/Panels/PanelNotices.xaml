<UserControl x:Class="WinGnome.Features.Settings.Panels.PanelNotices" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             Focusable="False" IsTabStop="False">
    <!-- Top of every system panel: the safe-mode note and the last problem, bound to SystemPanelViewModel. -->
    <StackPanel>
        <Border Margin="0,0,0,20" Padding="16,12" CornerRadius="12" Background="{DynamicResource HoverBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding ReadOnlyNote, Converter={x:Static c:Converters.NotNullToVisibility}}">
            <TextBlock Text="{Binding ReadOnlyNote}" Style="{DynamicResource RowSubtitleText}" />
        </Border>
        <Border Margin="0,0,0,20" Padding="16,12" CornerRadius="12" Background="#33E01B24" BorderBrush="#99E01B24" BorderThickness="1"
                Visibility="{Binding Problem, Converter={x:Static c:Converters.NotNullToVisibility}}"
                AutomationProperties.Name="Problem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Problem}" Style="{DynamicResource RowSubtitleText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="1" Content="Open Windows Settings" Style="{DynamicResource SettingsButton}"
                        Command="{Binding OpenInWindowsCommand}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
