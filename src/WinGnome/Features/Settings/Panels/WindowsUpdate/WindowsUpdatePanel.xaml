<UserControl x:Class="WinGnome.Features.Settings.Panels.WindowsUpdate.WindowsUpdatePanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             xmlns:p="clr-namespace:WinGnome.Features.Settings.Panels">
    <StackPanel>
        <p:PanelNotices />

        <c:SettingsGroup Header="Status" Description="What Windows already knows. WinGnome doesn't contact Windows Update or install anything; use Check for updates for that.">
            <ProgressBar IsIndeterminate="True" Height="3" Margin="16,12" AutomationProperties.Name="Reading update status"
                         Visibility="{Binding IsLoading, Converter={x:Static c:Converters.BoolToVisibility}}" />
            <c:SettingsRow Title="Last Checked" Subtitle="{Binding LastChecked}"
                           Visibility="{Binding HasStatus, Converter={x:Static c:Converters.BoolToVisibility}}" />
            <c:SettingsRow Title="Last Installed" Subtitle="{Binding LastInstalled}"
                           Visibility="{Binding HasStatus, Converter={x:Static c:Converters.BoolToVisibility}}" />
            <c:SettingsRow Title="Updates" Subtitle="{Binding Pending}"
                           Visibility="{Binding HasStatus, Converter={x:Static c:Converters.BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding PendingTitles}" Focusable="False" AutomationProperties.Name="Updates waiting">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{DynamicResource RowSubtitleText}" Margin="32,0,16,8" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <c:SettingsRow Title="Restart" Subtitle="{Binding Restart}"
                           Visibility="{Binding HasStatus, Converter={x:Static c:Converters.BoolToVisibility}}" />
            <c:SettingsRow Title="Refresh" Subtitle="Read the status again.">
                <Button Content="Refresh" Style="{DynamicResource SettingsButton}" Command="{Binding RefreshCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <c:SettingsGroup Header="Windows Update">
            <c:SettingsRow Title="Check for Updates" Subtitle="Opens Windows Settings and starts a check.">
                <Button Content="Check" Style="{DynamicResource SettingsButton}" Command="{Binding CheckCommand}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Update History">
                <Button Content="Open" Style="{DynamicResource SettingsButton}" Command="{Binding HistoryCommand}" />
            </c:SettingsRow>
            <c:SettingsRow Title="Advanced Options">
                <Button Content="Open" Style="{DynamicResource SettingsButton}" Command="{Binding OptionsCommand}" />
            </c:SettingsRow>
        </c:SettingsGroup>

        <p:PanelFooter />
    </StackPanel>
</UserControl>
