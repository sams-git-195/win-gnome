<UserControl x:Class="WinGnome.Features.Settings.Controls.ColorPickerRow" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WinGnome.Features.Settings.Controls"
             x:Name="Root">
    <!--
        Edits a ColorEditor (the DataContext): hex text box with validation, live swatch, preset swatches and,
        for optional colours, a button that goes back to the default. Styles come from SettingsControls.xaml
        through DynamicResource because this control is built before it is placed in a window.
    -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="{Binding DefaultLabel, ElementName=Root}" Command="{Binding UseDefaultCommand}"
                Style="{DynamicResource SettingsButton}" Margin="0,0,10,0"
                Visibility="{Binding IsOptional, Converter={x:Static c:Converters.BoolToVisibility}}" />

        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,10,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{DynamicResource SwatchButton}" Background="{Binding Brush}" ToolTip="{Binding Name}"
                            AutomationProperties.Name="{Binding Name}"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Preset}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,8,0" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PreviewBackdropBrush}" ClipToBounds="True">
            <Border CornerRadius="7" Background="{Binding Swatch}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter Property="Background" Value="{Binding DefaultBrush, ElementName=Root}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Border>

        <TextBox Width="104" MaxLength="9" ToolTip="{Binding Error}"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
    </StackPanel>
</UserControl>
