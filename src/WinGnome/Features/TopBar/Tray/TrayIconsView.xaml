<UserControl x:Class="WinGnome.Features.TopBar.Tray.TrayIconsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinGnome.Features.TopBar.Controls">
    <!--
        Tray icons in the order apps added them. Uses the bar window's Bar* resources (DynamicResource), so icons
        follow the bar's icon size, hover colour and item corner radius live.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding Icons}" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Item" Margin="{DynamicResource BarPillMargin}" Padding="7,0" Background="Transparent"
                        controls:PillCorners.Radius="{DynamicResource TopBarItemCornerRadius}"
                        Visibility="{Binding IsVisible, Converter={StaticResource VisibleWhen}}"
                        ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="400"
                        AutomationProperties.Name="{Binding State.Tip}"
                        MouseEnter="OnIconMouseEnter" MouseLeave="OnIconMouseLeave"
                        MouseDown="OnIconMouseDown" MouseUp="OnIconMouseUp">
                    <!-- The slot is the bar's icon size; the bitmap inside it is placed on whole pixels (TrayIconPlacement). -->
                    <Grid Width="{DynamicResource BarIconSize}" Height="{DynamicResource BarIconSize}" VerticalAlignment="Center">
                        <Image Source="{Binding Image}" Width="{Binding ImageSize}" Height="{Binding ImageSize}" Margin="{Binding ImageMargin}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="{Binding ScalingMode}" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Item" Property="Background" Value="{DynamicResource BarHover}" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
