<UserControl x:Class="WinGnome.Features.TopBar.Popups.QuickSettingsCard"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinGnome.Features.TopBar"
             xmlns:controls="clr-namespace:WinGnome.Features.TopBar.Controls"
             Width="356"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PopupStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhen" />

            <!-- Tile content: icon, title and a dimmer subtitle. -->
            <Style x:Key="TileTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="TileSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- Wi-Fi tile turns accent-coloured while connected over Wi-Fi, like an active GNOME toggle. -->
            <!-- Small chevron at the end of a slider row that opens the matching settings panel (GNOME's menu arrow). -->
            <Style x:Key="RowSettingsButton" TargetType="Button" BasedOn="{StaticResource QuickRoundButton}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Content" Value="&#xE76C;" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="WifiTile" TargetType="Button" BasedOn="{StaticResource QuickTile}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWifiConnected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="4">
        <!-- Volume: mute toggle, live slider, percentage. Scrolling anywhere on the row also changes the volume. The
             chevron opens the Sound panel and stays enabled without an audio device, when it is most useful. -->
        <DockPanel Margin="4,2,4,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource RowSettingsButton}" ToolTip="Sound settings"
                    AutomationProperties.Name="Sound settings" Tag="{x:Static local:TopBarAction.SoundSettings}" Click="OnActionClick" />
            <Grid IsEnabled="{Binding IsVolumeAvailable}" Background="Transparent" MouseWheel="OnVolumeWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource QuickRoundButton}" Background="Transparent" ToolTip="Mute" Click="OnMuteClick">
                    <controls:SymbolicIcon Icon="{Binding VolumeIcon}" />
                </Button>
                <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource QuickSlider}"
                        Value="{Binding VolumePercent, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Text="{Binding VolumeText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
            </Grid>
        </DockPanel>

        <!-- Brightness: same row as the volume, minus the mute button. Hidden when no panel supports brightness control. -->
        <DockPanel Margin="4,0,4,10" Visibility="{Binding IsBrightnessAvailable, Converter={StaticResource VisibleWhen}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource RowSettingsButton}" ToolTip="Display settings"
                    AutomationProperties.Name="Display settings" Tag="{x:Static local:TopBarAction.DisplaySettings}" Click="OnActionClick" />
            <Grid Background="Transparent" MouseWheel="OnBrightnessWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <!-- Purely an icon: not clickable, so it takes no hover or press highlight. -->
                <Button Style="{StaticResource QuickRoundButton}" Background="Transparent" Content="&#xE706;"
                        IsHitTestVisible="False" IsTabStop="False" Focusable="False" />
                <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource QuickSlider}"
                        Value="{Binding BrightnessPercent, Mode=TwoWay}" AutomationProperties.Name="Screen brightness"
                        PreviewKeyDown="OnBrightnessKeyDown" />
                <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
            </Grid>
        </DockPanel>

        <!-- Tiles. -->
        <UniformGrid Columns="2">
            <Button Style="{StaticResource WifiTile}" Tag="{x:Static local:TopBarAction.WifiSettings}" Click="OnActionClick">
                <StackPanel Orientation="Horizontal">
                    <controls:SymbolicIcon Icon="NetworkWireless" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center" MaxWidth="110">
                        <TextBlock Style="{StaticResource TileTitle}" Text="Wi-Fi" />
                        <TextBlock Style="{StaticResource TileSubtitle}" Text="{Binding NetworkText}" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource QuickTile}" Tag="{x:Static local:TopBarAction.BluetoothSettings}" Click="OnActionClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE702;" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource TileTitle}" Text="Bluetooth" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource QuickTile}" Tag="{x:Static local:TopBarAction.WindowsQuickSettings}" Click="OnActionClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9E9;" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center" MaxWidth="110">
                        <TextBlock Style="{StaticResource TileTitle}" Text="Windows" />
                        <TextBlock Style="{StaticResource TileSubtitle}" Text="Quick settings" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource QuickTile}" Tag="{x:Static local:TopBarAction.Notifications}" Click="OnActionClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xEA8F;" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource TileTitle}" Text="Notifications" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource QuickTile}" Tag="{x:Static local:TopBarAction.ShowSystemTray}" Click="OnActionClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE70E;" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center" MaxWidth="110">
                        <TextBlock Style="{StaticResource TileTitle}" Text="System tray" />
                        <TextBlock Style="{StaticResource TileSubtitle}" Text="Show taskbar" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Battery: opens the Power panel. -->
        <Button Style="{StaticResource MenuRowButton}" Margin="4,6,4,0" Padding="6,4" ToolTip="Power settings"
                Visibility="{Binding HasBattery, Converter={StaticResource VisibleWhen}}"
                Tag="{x:Static local:TopBarAction.PowerSettings}" Click="OnActionClick">
            <StackPanel Orientation="Horizontal">
                <controls:SymbolicIcon Icon="{Binding BatteryIcon}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BatterySummary}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Border Height="1" Margin="4,12,4,10" Background="{DynamicResource BorderBrush}" />

        <!-- System row. -->
        <DockPanel Margin="4,0,4,2" LastChildFill="False">
            <Button Style="{StaticResource QuickRoundButton}" Content="&#xE924;" ToolTip="Take a screenshot" Margin="0,0,8,0"
                    Tag="{x:Static local:TopBarAction.Screenshot}" Click="OnActionClick" />
            <Button Style="{StaticResource QuickRoundButton}" Content="&#xE713;" ToolTip="Settings" Margin="0,0,8,0"
                    Tag="{x:Static local:TopBarAction.Settings}" Click="OnActionClick" />
            <Button Style="{StaticResource QuickRoundButton}" Content="&#xE9F5;" ToolTip="WinGnome settings"
                    Tag="{x:Static local:TopBarAction.WinGnomeSettings}" Click="OnActionClick" />
            <Button x:Name="PowerButton" DockPanel.Dock="Right" Style="{StaticResource QuickRoundButton}"
                    ToolTip="Power off / Log out" Click="OnPowerClick">
                <controls:SymbolicIcon Icon="SystemShutdown" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource QuickRoundButton}" Content="&#xE72E;" ToolTip="Lock" Margin="0,0,8,0"
                    Tag="{x:Static local:TopBarAction.Lock}" Click="OnActionClick" />
        </DockPanel>

        <!-- Power menu, expanded in place under the system row (GNOME 43+ submenu). -->
        <Border x:Name="PowerMenu" Visibility="Collapsed" Margin="4,10,4,0" Padding="4" CornerRadius="12"
                Background="{DynamicResource HoverBrush}">
            <StackPanel>
                <Button Style="{StaticResource MenuRowButton}" Tag="{x:Static local:TopBarAction.Suspend}" Click="OnActionClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE708;" Margin="0,0,12,0" />
                        <TextBlock Text="Suspend" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuRowButton}" Tag="{x:Static local:TopBarAction.Restart}" Click="OnActionClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE777;" Margin="0,0,12,0" />
                        <TextBlock Text="Restart…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuRowButton}" Tag="{x:Static local:TopBarAction.ShutDown}" Click="OnActionClick">
                    <StackPanel Orientation="Horizontal">
                        <controls:SymbolicIcon Icon="SystemShutdown" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Power Off…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuRowButton}" Tag="{x:Static local:TopBarAction.SignOut}" Click="OnActionClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xF3B1;" Margin="0,0,12,0" />
                        <TextBlock Text="Log Out…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Height="1" Margin="8,4" Background="{DynamicResource BorderBrush}" />
                <Button Style="{StaticResource MenuRowButton}" Tag="{x:Static local:TopBarAction.Quit}" Click="OnActionClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" Margin="0,0,12,0" />
                        <TextBlock Text="Quit WinGnome" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
