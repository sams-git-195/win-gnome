<Window x:Class="WinGnome.Features.TopBar.Popups.ConfirmDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinGnome"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="PopupStyles.xaml" />
    </Window.Resources>
    <!-- GNOME-style end-session dialog: a centred card with a title, a message and Cancel / destructive buttons. -->
    <Border Padding="24">
        <Border Style="{StaticResource CardBorder}" Padding="24,22,24,20" Width="380" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.4" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock x:Name="MessageText" Margin="0,10,0,22" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <UniformGrid Columns="2">
                    <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}" Margin="0,0,6,0"
                            Click="OnCancel" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource DestructiveDialogButton}" Margin="6,0,0,0" Click="OnConfirm" />
                </UniformGrid>
            </StackPanel>
        </Border>
    </Border>
</Window>
