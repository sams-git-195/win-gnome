<UserControl x:Class="WinGnome.Features.TopBar.Popups.LogoMenuCard"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinGnome.Features.TopBar"
             MinWidth="250"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             UseLayoutRounding="True"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PopupStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                macOS-style menu row: the selected row (pointer or arrow keys; the pointer moves the keyboard focus, so
                there is only ever one) is filled with the accent colour. The keyboard shortcut, if any, comes from
                AutomationProperties.AcceleratorKey and is shown right-aligned.
            -->
            <Style x:Key="LogoMenuItem" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource ShellFont}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <TextBlock x:Name="Hint" Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Opacity="0.6"
                                               Text="{Binding (AutomationProperties.AcceleratorKey), RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                    <Setter TargetName="Hint" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                    <Setter TargetName="Hint" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MenuSeparator" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="10,5" />
                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="Items" Margin="5">
        <Button Style="{StaticResource LogoMenuItem}" Content="About This PC" Tag="{x:Static local:TopBarAction.AboutThisPc}" />
        <Border Style="{StaticResource MenuSeparator}" />
        <Button Style="{StaticResource LogoMenuItem}" Content="System Settings…" Tag="{x:Static local:TopBarAction.WindowsSettings}" AutomationProperties.AcceleratorKey="Win+I" />
        <Button Style="{StaticResource LogoMenuItem}" Content="WinGnome Settings…" Tag="{x:Static local:TopBarAction.WinGnomeSettings}" />
        <Button Style="{StaticResource LogoMenuItem}" Content="Microsoft Store…" Tag="{x:Static local:TopBarAction.MicrosoftStore}" />
        <Border Style="{StaticResource MenuSeparator}" />
        <Button Style="{StaticResource LogoMenuItem}" Content="Start Menu" Tag="{x:Static local:TopBarAction.StartMenu}" AutomationProperties.AcceleratorKey="Ctrl+Esc" />
        <Button Style="{StaticResource LogoMenuItem}" Content="Task Manager…" Tag="{x:Static local:TopBarAction.TaskManager}" AutomationProperties.AcceleratorKey="Ctrl+Shift+Esc" />
        <Border Style="{StaticResource MenuSeparator}" />
        <Button Style="{StaticResource LogoMenuItem}" Content="Sleep" Tag="{x:Static local:TopBarAction.Suspend}" />
        <Button Style="{StaticResource LogoMenuItem}" Content="Restart…" Tag="{x:Static local:TopBarAction.Restart}" />
        <Button Style="{StaticResource LogoMenuItem}" Content="Shut Down…" Tag="{x:Static local:TopBarAction.ShutDown}" />
        <Border Style="{StaticResource MenuSeparator}" />
        <Button Style="{StaticResource LogoMenuItem}" Content="Lock Screen" Tag="{x:Static local:TopBarAction.Lock}" AutomationProperties.AcceleratorKey="Win+L" />
        <Button x:Name="LogOutItem" Style="{StaticResource LogoMenuItem}" Content="Log Out…" Tag="{x:Static local:TopBarAction.SignOut}" />
        <Border Style="{StaticResource MenuSeparator}" />
        <Button Style="{StaticResource LogoMenuItem}" Content="Quit WinGnome" Tag="{x:Static local:TopBarAction.Quit}" />
    </StackPanel>
</UserControl>
