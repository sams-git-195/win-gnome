<Window x:Class="WinGnome.Features.Overview.OverviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinGnome.Features.Overview"
        Title="Activities"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        UseLayoutRounding="True"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="{StaticResource ShellFont}"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated"
        Closing="OnClosing">
    <!--
        GNOME "Activities". The overview is always dark, whatever the app theme, like GNOME's.
        Live window thumbnails are drawn by DWM on top of ThumbnailCanvas; everything else is WPF.
    -->
    <Window.Resources>
        <!-- Shared look of app tiles and window results: transparent until hovered or keyboard-selected. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#38FFFFFF" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AppTileTemplate" DataType="{x:Type local:AppTile}">
            <!-- 136 x 136 must match OverviewWindow.AppTileSize, which the grid's column maths uses. -->
            <Button Style="{StaticResource TileButton}" Width="136" Height="136" Padding="8">
                <StackPanel>
                    <Image Source="{Binding Icon}" Width="64" Height="64" Margin="0,6,0,8"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="36" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="WindowResultTemplate" DataType="{x:Type local:WindowResult}">
            <Button Style="{StaticResource TileButton}" HorizontalContentAlignment="Left" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                        <TextBlock Text="{Binding AppName}" FontSize="12" Opacity="0.65" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="12,18,0,8" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="OnBackgroundMouseDown">
        <!-- Darkens the blurred desktop; strength follows the Activities backdrop opacity setting. -->
        <Rectangle x:Name="Dimmer" Fill="Black" IsHitTestVisible="False" />

        <Canvas x:Name="ThumbnailCanvas" />

        <ScrollViewer x:Name="AppGridScroller" Margin="0,112,0,24" Focusable="False" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="AppGrid" HorizontalAlignment="Center" Focusable="False"
                          ItemTemplate="{StaticResource AppTileTemplate}"
                          ButtonBase.Click="OnAppTileClick" MouseRightButtonUp="OnAppTileRightClick">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <ScrollViewer x:Name="ResultsScroller" Margin="0,112,0,24" Focusable="False" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ResultsPanel" HorizontalAlignment="Center">
                <TextBlock x:Name="AppsHeader" Text="Applications" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="AppResults" Focusable="False" ItemTemplate="{StaticResource AppTileTemplate}"
                              ButtonBase.Click="OnAppTileClick" MouseRightButtonUp="OnAppTileRightClick">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="WindowsHeader" Text="Windows" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="WindowResults" Focusable="False" ItemTemplate="{StaticResource WindowResultTemplate}"
                              ButtonBase.Click="OnWindowResultClick" />
                <TextBlock x:Name="NoResults" Text="No results" FontSize="16" Opacity="0.7"
                           HorizontalAlignment="Center" Margin="0,48,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="SearchPill" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,36,0,0"
                Width="420" Height="40" CornerRadius="20" Background="#2EFFFFFF" Padding="16,0"
                MouseLeftButtonDown="OnSearchPillMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Opacity="0.8"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Type to search" FontSize="15" Opacity="0.6"
                           VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0" />
                <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="15" Foreground="White" CaretBrush="White"
                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                         SelectionBrush="{DynamicResource AccentBrush}" TextChanged="OnSearchTextChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
