<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- GNOME Adwaita dark palette. Reference these with DynamicResource so theme switches apply live. -->
    <Color x:Key="WindowBackgroundColor">#242424</Color>
    <Color x:Key="HeaderBackgroundColor">#303030</Color>
    <Color x:Key="CardBackgroundColor">#383838</Color>
    <Color x:Key="PopupBackgroundColor">#383838</Color>
    <Color x:Key="ForegroundColor">#FFFFFF</Color>
    <Color x:Key="SecondaryForegroundColor">#C0BFBC</Color>
    <Color x:Key="AccentColor">#3584E4</Color>
    <Color x:Key="DestructiveColor">#E01B24</Color>
    <Color x:Key="SuccessColor">#2EC27E</Color>
    <Color x:Key="HoverColor">#1AFFFFFF</Color>
    <Color x:Key="PressedColor">#2EFFFFFF</Color>
    <Color x:Key="BorderColor">#1FFFFFFF</Color>
    <Color x:Key="DockBackgroundColor">#242424</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource PopupBackgroundColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DestructiveBrush" Color="{StaticResource DestructiveColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DockBackgroundBrush" Color="{StaticResource DockBackgroundColor}" />
</ResourceDictionary>
