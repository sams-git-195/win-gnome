    <!--
        WinGnome's own GNOME-style symbolic icons for the top bar's status area and popups, drawn for this project
        (not copied from Adwaita's icon theme). Every shape sits on a 16-unit grid and uses solid fills or 2-unit
        strokes; SymbolicIcon scales them to whole device pixels and snaps their corners to the pixel grid.
        F0 = even-odd fill (outlines with holes, the battery bolt cut out of the charge), F1 = non-zero.
        StatusIcons maps network, volume and battery state to these keys.
    -->
    <!-- Wi-Fi connected: solid signal wedge. -->
    <StreamGeometry x:Key="NetworkWireless" po:Freeze="True">F1 M8,14 L0.22,6.22 A11,11 0 0 1 15.78,6.22 Z</StreamGeometry>
    <!-- Wi-Fi connected, signal at level 1 to 3 of 4 (a connected network is never drawn empty, which is the offline icon): the hollow wedge with the lit part filled (even-odd, so the lit wedge sits inside the hole). -->
    <StreamGeometry x:Key="NetworkWireless1" po:Freeze="True">F0 M8,14 L0.22,6.22 A11,11 0 0 1 15.78,6.22 Z M8,11.17 L3.21,6.38 A9,9 0 0 1 12.79,6.38 Z M8,11.17 L6.56,9.73 A4.5,4.5 0 0 1 9.44,9.73 Z</StreamGeometry>
