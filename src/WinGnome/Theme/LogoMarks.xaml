<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <!--
        WinGnome's own logo marks for the top bar's logo button (spec 0021), drawn for this project (not copied from
        Adwaita's icon theme, the same policy SymbolicIcons.xaml states). Every shape sits on the 16-unit grid and uses
        solid fills; LogoGlyph scales them to whole device pixels and snaps their corners like SymbolicIcon does.
        F0 = even-odd fill (outlines with holes), F1 = non-zero.
    -->
    <!-- Foot: an original GNOME-style footprint — a sole with four toes. -->
    <StreamGeometry x:Key="LogoFoot" po:Freeze="True">F1 M8,6 C10.8,6 12,8.2 12,10.6 C12,13.1 10.3,15 8,15 C5.7,15 4,13.1 4,10.6 C4,8.2 5.2,6 8,6 Z M3.7,4.6 A1.5,1.5 0 1 0 6.7,4.6 A1.5,1.5 0 1 0 3.7,4.6 Z M6.55,3.4 A1.25,1.25 0 1 0 9.05,3.4 A1.25,1.25 0 1 0 6.55,3.4 Z M9.05,3.9 A1.15,1.15 0 1 0 11.35,3.9 A1.15,1.15 0 1 0 9.05,3.9 Z M11.25,5.2 A0.95,0.95 0 1 0 13.15,5.2 A0.95,0.95 0 1 0 11.25,5.2 Z</StreamGeometry>
    <!-- Star: a five-point star centred on the grid. -->
    <StreamGeometry x:Key="LogoStar" po:Freeze="True">F1 M8,0 L9.76,5.57 L15.61,5.53 L10.85,8.93 L12.7,14.47 L8,11 L3.3,14.47 L5.15,8.93 L0.39,5.53 L6.24,5.57 Z</StreamGeometry>
    <!-- Terminal: a >_ prompt in a rounded box. -->
    <StreamGeometry x:Key="LogoTerminal" po:Freeze="True">F0 M2,2 H14 A2,2 0 0 1 16,4 V12 A2,2 0 0 1 14,14 H2 A2,2 0 0 1 0,12 V4 A2,2 0 0 1 2,2 Z M3,4 H13 A1,1 0 0 1 14,5 V11 A1,1 0 0 1 13,12 H3 A1,1 0 0 1 2,11 V5 A1,1 0 0 1 3,4 Z M3,5.5 L7.5,8 L3,10.5 L3,9 L5.7,8 L3,7 Z M8,9.5 H12.5 V11 H8 Z</StreamGeometry>
</ResourceDictionary>
